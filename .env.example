# Contributions graph — optional, but without it the graph counts public work only.
#
# A token owned by the profile in `lib/github-contributions.ts` lets the section
# count commits pushed to private repositories and show how many of the year's work
# happened there. Repository names stay on the server; only the totals are rendered.
#
# Classic PAT: `repo` scope. Fine-grained: read access to the private repos that
# should count. Also turn on GitHub → Settings → Public profile → "Include private
# contributions on my profile" so the calendar totals include them.
#
# With no token the section falls back to the public calendar and hides the
# private breakdown line, so a missing or expired token never breaks the page.
GITHUB_CONTRIBUTIONS_TOKEN=

# Contact form (app/api/contact/route.ts). Without the key the route refuses the
# submission rather than pretending it sent, so this one is not optional in prod.
RESEND_API_KEY=
# Sender address. Falls back to Resend's shared onboarding@resend.dev, which only
# delivers to the account owner — fine to test with, not to ship on.
CONTACT_FROM_EMAIL=

# Cal.com booking link behind the contact CTA. Defaults to burakhasici/30min.
NEXT_PUBLIC_CAL_LINK=
